<odoo>
    <record id="alfia_quality_check_view_list" model="ir.ui.view">
        <field name="name">alfia.quality.check.list</field>
        <field name="model">alfia.quality.check</field>
        <field name="arch" type="xml">
            <list>
                <field name="picking_id"/><field name="partner_id"/><field name="product_id"/><field name="lot_names" optional="show"/>
                <field name="quantity"/><field name="uom_id"/><field name="location_id" optional="show"/><field name="received_by_id" optional="hide"/>
                <field name="inspector_id" optional="show"/><field name="state" widget="badge"
                       decoration-warning="state == 'pending'" decoration-success="state == 'passed'" decoration-danger="state == 'rejected'"/>
            </list>
        </field>
    </record>
    <record id="alfia_quality_check_view_form" model="ir.ui.view">
        <field name="name">alfia.quality.check.form</field>
        <field name="model">alfia.quality.check</field>
        <field name="arch" type="xml">
            <form create="0">
                <header>
                    <button name="action_accept" string="Accept into stock" type="object" class="btn-primary" invisible="state != 'pending'" groups="alfia_controls.group_quality_inspector"/>
                    <button name="action_reject" string="Reject" type="object" invisible="state != 'pending'" groups="alfia_controls.group_quality_inspector"
                            confirm="The goods will be moved to Rejected goods for return to the supplier. Continue?"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <h1><field name="name" readonly="1"/></h1>
                    <group>
                        <group>
                            <field name="picking_id"/><field name="partner_id"/><field name="product_id"/><field name="lot_names"/>
                            <field name="quantity"/><field name="uom_id"/>
                        </group>
                        <group>
                            <field name="location_id"/><field name="received_by_id"/><field name="inspector_id"/><field name="decided_date"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group>
                        <field name="findings" readonly="state != 'pending'" placeholder="Packaging, temperature, expiry, documents, quantity counted..."/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="alfia_quality_check_view_search" model="ir.ui.view">
        <field name="name">alfia.quality.check.search</field>
        <field name="model">alfia.quality.check</field>
        <field name="arch" type="xml">
            <search>
                <field name="picking_id"/><field name="product_id"/><field name="partner_id"/>
                <filter name="pending" string="Waiting for inspection" domain="[('state', '=', 'pending')]"/>
                <filter name="rejected" string="Rejected" domain="[('state', '=', 'rejected')]"/>
                <group><filter name="by_state" string="Status" context="{'group_by': 'state'}"/></group>
            </search>
        </field>
    </record>
    <record id="alfia_quality_check_action" model="ir.actions.act_window">
        <field name="name">Receipt inspections</field>
        <field name="res_model">alfia.quality.check</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_pending': 1}</field>
        <field name="help" type="html"><p>Goods of categories marked "Inspect on receipt" appear here when they are received.</p></field>
    </record>
    <record id="alfia_product_category_form_inspection" model="ir.ui.view">
        <field name="name">product.category.form.alfia.inspection</field>
        <field name="model">product.category</field>
        <field name="inherit_id" ref="product.product_category_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='first']" position="inside">
                <field name="alfia_requires_inspection"/>
            </xpath>
        </field>
    </record>
</odoo>
