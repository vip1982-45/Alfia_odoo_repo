<odoo>
    <record id="alfia_period_close_view_list" model="ir.ui.view">
        <field name="name">alfia.period.close.list</field>
        <field name="model">alfia.period.close</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/><field name="lock"/><field name="requested_by_id"/><field name="approved_by_id"/>
                <field name="approved_date" optional="show"/><field name="previous_lock_date" optional="hide"/>
                <field name="state" widget="badge" decoration-success="state == 'done'" decoration-warning="state == 'submitted'"/>
            </list>
        </field>
    </record>
    <record id="alfia_period_close_view_form" model="ir.ui.view">
        <field name="name">alfia.period.close.form</field>
        <field name="model">alfia.period.close</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_submit" string="Submit for approval" type="object" class="btn-primary" invisible="state not in ('draft', 'rejected')"/>
                    <button name="action_approve" string="Approve and lock" type="object" class="btn-primary" invisible="state != 'submitted'"/>
                    <button name="action_reject" string="Reject" type="object" invisible="state != 'submitted'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,done"/>
                </header>
                <sheet>
                    <h1><field name="name" readonly="1"/></h1>
                    <group>
                        <group>
                            <field name="kind" readonly="state in ('submitted', 'done')"/>
                            <field name="date" readonly="state in ('submitted', 'done')"/>
                            <field name="lock" readonly="state in ('submitted', 'done')"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="state in ('submitted', 'done')"/>
                        </group>
                        <group>
                            <field name="current_lock_date"/><field name="requested_by_id"/><field name="approved_by_id"/>
                            <field name="approved_date"/><field name="previous_lock_date" invisible="state != 'done'"/>
                        </group>
                    </group>
                    <group string="Before closing" invisible="kind != 'close'">
                        <field name="draft_count" decoration-danger="draft_count &gt; 0"/>
                        <field name="unreconciled_count" decoration-danger="unreconciled_count &gt; 0"/>
                        <field name="pending_inspections" decoration-warning="pending_inspections &gt; 0"/>
                    </group>
                    <field name="reason" placeholder="Why the period must be reopened" invisible="kind != 'reopen'"
                           readonly="state in ('submitted', 'done')"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="alfia_period_close_action" model="ir.actions.act_window">
        <field name="name">Period closes</field>
        <field name="res_model">alfia.period.close</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html"><p>One finance manager prepares the close of a period; another approves it, which sets the lock date.
            Reopening works the same way, with a reason.</p></field>
    </record>
    <record id="alfia_move_form_manual" model="ir.ui.view">
        <field name="name">account.move.form.alfia.manual</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="after">
                <div class="alert alert-info mb-0" role="status" invisible="not alfia_manual or state != 'draft'">
                    A manual journal entry is posted by a second person, who reviews it.
                </div>
            </xpath>
        </field>
    </record>
</odoo>
