<odoo>
    <record id="alfia_purchase_request_view_list" model="ir.ui.view">
        <field name="name">alfia.purchase.request.list</field>
        <field name="model">alfia.purchase.request</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/><field name="requested_by_id"/><field name="date_needed"/><field name="estimated_total"/>
                <field name="approved_by_id" optional="show"/><field name="state" widget="badge"/>
            </list>
        </field>
    </record>
    <record id="alfia_purchase_request_view_form" model="ir.ui.view">
        <field name="name">alfia.purchase.request.form</field>
        <field name="model">alfia.purchase.request</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_submit" string="Submit for approval" type="object" class="btn-primary" invisible="state not in ('draft', 'rejected')"/>
                    <button name="action_approve" string="Approve" type="object" class="btn-primary" invisible="state != 'submitted'" groups="purchase.group_purchase_manager"/>
                    <button name="action_reject" string="Reject" type="object" invisible="state != 'submitted'" groups="purchase.group_purchase_manager"/>
                    <button name="action_create_rfq" string="Create requests for quotation" type="object" class="btn-primary" invisible="state != 'approved'" groups="purchase.group_purchase_user"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="state in ('ordered', 'cancelled')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved,ordered"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_orders" type="object" class="oe_stat_button" icon="fa-shopping-cart" invisible="not purchase_order_count">
                            <field name="purchase_order_count" widget="statinfo" string="Orders"/>
                        </button>
                    </div>
                    <h1><field name="name" readonly="1"/></h1>
                    <group>
                        <group>
                            <field name="requested_by_id"/>
                            <field name="location_id" readonly="state not in ('draft', 'rejected')"/>
                            <field name="date_needed" readonly="state not in ('draft', 'rejected')"/>
                        </group>
                        <group>
                            <field name="estimated_total"/>
                            <field name="approved_by_id"/>
                            <field name="approved_date"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group>
                        <field name="reason" readonly="state not in ('draft', 'rejected')"/>
                        <field name="rejection_reason" invisible="state not in ('submitted', 'rejected')" readonly="state != 'submitted'"/>
                    </group>
                    <field name="line_ids" readonly="state not in ('draft', 'rejected')">
                        <list editable="bottom">
                            <field name="product_id"/><field name="description" optional="show"/><field name="quantity"/><field name="uom_id"/>
                            <field name="vendor_id"/><field name="estimated_price"/><field name="purchase_order_id" readonly="1"/>
                        </list>
                    </field>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="alfia_purchase_request_view_search" model="ir.ui.view">
        <field name="name">alfia.purchase.request.search</field>
        <field name="model">alfia.purchase.request</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/><field name="requested_by_id"/><field name="line_ids" string="Product" filter_domain="[('line_ids.product_id', 'ilike', self)]"/>
                <filter name="mine" string="My requests" domain="[('requested_by_id', '=', uid)]"/>
                <filter name="to_approve" string="Waiting for approval" domain="[('state', '=', 'submitted')]"/>
                <filter name="to_order" string="Approved, to order" domain="[('state', '=', 'approved')]"/>
            </search>
        </field>
    </record>
    <record id="alfia_purchase_request_action" model="ir.actions.act_window">
        <field name="name">Purchase requests</field>
        <field name="res_model">alfia.purchase.request</field>
        <field name="view_mode">list,form</field>
    </record>
    <!-- The purchase order line shows the request it came from. -->
    <record id="purchase_order_form_request_link" model="ir.ui.view">
        <field name="name">purchase.order.form.alfia.request</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/list/field[@name='date_planned']" position="after">
                <field name="alfia_request_id" optional="hide" readonly="1"/>
            </xpath>
        </field>
    </record>
</odoo>
