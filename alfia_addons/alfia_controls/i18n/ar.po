#: code:addons/alfia_controls/models/approval.py:0
msgid ""
"%(doc)s is %(amount)s, above your approval limit of %(limit)s. Someone with "
"a higher limit must approve it."
msgstr ""
"قيمة %(doc)s هي %(amount)s، وهي أعلى من حد اعتمادك البالغ %(limit)s. يجب أن "
"يعتمده شخص بحد أعلى."

#. module: alfia_controls
#. odoo-python
#: code:addons/alfia_controls/models/approval.py:0
msgid ""
"%(doc)s is above your own approval limit of %(limit)s, and the limit "
"delegated to you by %(owner)s does not cover documents you created yourself."
" Someone else must approve it."
msgstr ""
"%(doc)s أعلى من حد اعتمادك الشخصي البالغ %(limit)s، والحد المفوَّض إليك من "
"%(owner)s لا يشمل المستندات التي أنشأتها بنفسك. يجب أن يعتمده شخص آخر."

