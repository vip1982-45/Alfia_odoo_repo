<odoo>
    <record id="alfia_budget_view_list" model="ir.ui.view">
        <field name="name">alfia.budget.list</field>
        <field name="model">alfia.budget</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/><field name="version"/><field name="date_from"/><field name="date_to"/><field name="control"/>
                <field name="planned_total" sum="Planned"/><field name="committed_total"/><field name="actual_total"/>
                <field name="currency_id" optional="show"/><field name="approved_by_id" optional="show"/>
                <field name="state" widget="badge" decoration-success="state == 'approved'" decoration-warning="state == 'submitted'"
                       decoration-muted="state == 'superseded'"/>
            </list>
        </field>
    </record>
    <record id="alfia_budget_view_form" model="ir.ui.view">
        <field name="name">alfia.budget.form</field>
        <field name="model">alfia.budget</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_submit" string="Submit for approval" type="object" class="btn-primary" invisible="state not in ('draft', 'rejected')"/>
                    <button name="action_approve" string="Approve" type="object" class="btn-primary" invisible="state != 'submitted'" groups="account.group_account_manager"/>
                    <button name="action_reject" string="Reject" type="object" invisible="state != 'submitted'" groups="account.group_account_manager"/>
                    <button name="action_new_version" string="New version" type="object" invisible="state != 'approved'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved"/>
                </header>
                <sheet>
                    <h1><field name="name" readonly="state not in ('draft', 'rejected')"/></h1>
                    <group>
                        <group>
                            <field name="date_from" readonly="state not in ('draft', 'rejected')"/>
                            <field name="date_to" readonly="state not in ('draft', 'rejected')"/>
                            <field name="control" readonly="state not in ('draft', 'rejected')"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="state not in ('draft', 'rejected')"/>
                        </group>
                        <group>
                            <field name="version"/><field name="previous_id" invisible="not previous_id"/><field name="currency_id"/>
                            <field name="prepared_by_id"/><field name="approved_by_id"/><field name="approved_date"/>
                        </group>
                    </group>
                    <group>
                        <group><field name="planned_total"/><field name="committed_total"/><field name="actual_total"/></group>
                    </group>
                    <field name="line_ids" readonly="state not in ('draft', 'rejected')">
                        <list editable="bottom">
                            <field name="account_id"/><field name="analytic_account_id" optional="show"/><field name="department_id" optional="show"/>
                            <field name="planned" sum="Planned"/><field name="committed" sum="Committed"/><field name="actual" sum="Actual"/>
                            <field name="forecast" optional="hide"/><field name="forecast_total" sum="Forecast"/>
                            <field name="available" sum="Available"/><field name="variance" sum="Variance"/>
                            <field name="currency_id" column_invisible="1"/>
                            <button name="action_view_actuals" type="object" icon="fa-list" title="Actual entries"/>
                            <button name="action_view_commitments" type="object" icon="fa-shopping-cart" title="Open purchase orders"/>
                        </list>
                    </field>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="alfia_budget_action" model="ir.actions.act_window">
        <field name="name">Budgets</field>
        <field name="res_model">alfia.budget</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html"><p>A budget plans amounts by account, and optionally by cost centre (a horse or activity) and department.
            One person prepares it, another finance manager approves it. Revise an approved budget with New version.</p></field>
    </record>
    <record id="alfia_budget_line_view_report" model="ir.ui.view">
        <field name="name">alfia.budget.line.report</field>
        <field name="model">alfia.budget.line</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" decoration-danger="available &lt; 0">
                <field name="budget_id"/><field name="account_id"/><field name="analytic_account_id"/><field name="department_id" optional="show"/>
                <field name="planned" sum="Planned"/><field name="committed" sum="Committed"/><field name="actual" sum="Actual"/>
                <field name="forecast_total" sum="Forecast"/><field name="available" sum="Available"/><field name="variance" sum="Variance"/>
                <field name="currency_id" optional="show"/>
                <button name="action_view_actuals" type="object" icon="fa-list" title="Actual entries"/>
                <button name="action_view_commitments" type="object" icon="fa-shopping-cart" title="Open purchase orders"/>
            </list>
        </field>
    </record>
    <record id="alfia_budget_line_view_search" model="ir.ui.view">
        <field name="name">alfia.budget.line.search</field>
        <field name="model">alfia.budget.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="budget_id"/><field name="account_id"/><field name="analytic_account_id"/><field name="department_id"/>
                <group>
                    <filter name="by_budget" string="Budget" context="{'group_by': 'budget_id'}"/>
                    <filter name="by_department" string="Department" context="{'group_by': 'department_id'}"/>
                    <filter name="by_cost_centre" string="Cost centre" context="{'group_by': 'analytic_account_id'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="alfia_budget_line_action" model="ir.actions.act_window">
        <field name="name">Budget vs actual</field>
        <field name="res_model">alfia.budget.line</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="alfia_budget_line_view_report"/>
        <field name="search_view_id" ref="alfia_budget_line_view_search"/>
        <field name="domain">[('budget_id.state', '=', 'approved')]</field>
        <field name="context">{'search_default_by_budget': 1}</field>
    </record>
    <record id="alfia_budget_override_view_form" model="ir.ui.view">
        <field name="name">alfia.budget.override.form</field>
        <field name="model">alfia.budget.override</field>
        <field name="arch" type="xml">
            <form>
                <p>The document may go over its budget once this is recorded. The reason is kept on the document.</p>
                <group><field name="reason"/><field name="res_model" invisible="1"/><field name="res_id" invisible="1"/></group>
                <footer>
                    <button name="action_confirm" string="Record override" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="alfia_purchase_order_form_budget" model="ir.ui.view">
        <field name="name">purchase.order.form.alfia.budget</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_alfia_budget_override" string="Budget override" type="object" groups="account.group_account_manager"
                        invisible="state not in ('draft', 'sent', 'to approve') or alfia_budget_override_by_id"/>
            </xpath>
            <xpath expr="//field[@name='partner_ref']" position="after">
                <field name="alfia_budget_override_by_id" invisible="not alfia_budget_override_by_id"/>
                <field name="alfia_budget_override_reason" invisible="not alfia_budget_override_by_id"/>
            </xpath>
        </field>
    </record>
    <record id="alfia_move_form_budget" model="ir.ui.view">
        <field name="name">account.move.form.alfia.budget</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_alfia_budget_override" string="Budget override" type="object" groups="account.group_account_manager"
                        invisible="move_type != 'in_invoice' or state != 'draft' or alfia_budget_override_by_id"/>
            </xpath>
            <xpath expr="//field[@name='ref']" position="after">
                <field name="alfia_budget_override_by_id" invisible="not alfia_budget_override_by_id"/>
                <field name="alfia_budget_override_reason" invisible="not alfia_budget_override_by_id"/>
            </xpath>
        </field>
    </record>
</odoo>
