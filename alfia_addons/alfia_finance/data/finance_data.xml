<odoo>
    <!-- Every internal user works with locations, routes (pick lists) and batches; access to them stays limited by site. -->
    <record id="base.group_user" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('stock.group_stock_multi_locations')), (4, ref('stock.group_adv_location')), (4, ref('stock.group_production_lot'))]"/>
    </record>
    <!-- Accounting staff allocate costs with analytic distribution (horses, sites). -->
    <record id="account.group_account_invoice" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('analytic.group_analytic_accounting'))]"/>
    </record>
</odoo>
