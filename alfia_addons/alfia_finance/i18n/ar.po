#. module: alfia_finance
#. odoo-python
#: code:addons/alfia_finance/models/controls.py:0
msgid ""
"%(order)s, %(product)s: receiving %(total)g against %(ordered)g ordered "
"exceeds the %(tol)g%% tolerance. Receive only what was ordered, or ask a "
"purchase manager to validate the excess."
msgstr ""
"%(order)s، %(product)s: استلام %(total)g مقابل %(ordered)g مطلوبة يتجاوز "
"نسبة السماح %(tol)g%%. استلم المطلوب فقط، أو اطلب من مدير المشتريات اعتماد "
"الزيادة."

#. module: alfia_finance
#. odoo-python
#: code:addons/alfia_finance/models/controls.py:0
msgid ""
"%(user)s accepted a receipt of %(total)g against %(ordered)g ordered for "
"%(product)s (above the %(tol)g%% tolerance)."
msgstr ""
"قبل %(user)s استلام %(total)g مقابل %(ordered)g مطلوبة من %(product)s (فوق "
"نسبة السماح %(tol)g%%)."

