<odoo>
    <record id="alfia_stock_picking_view_form" model="ir.ui.view">
        <field name="name">stock.picking.form.alfia</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_alfia_approve" type="object" string="Approve dispatch" class="btn-primary"
                        invisible="not alfia_missing_group_ids or state in ('done', 'cancel')"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Dispatch approvals" name="alfia_approvals" invisible="not alfia_required_group_ids">
                    <group>
                        <field name="alfia_required_group_ids" widget="many2many_tags" readonly="1"/>
                        <field name="alfia_missing_group_ids" widget="many2many_tags" readonly="1"/>
                    </group>
                    <field name="alfia_approval_ids" readonly="1">
                        <list>
                            <field name="group_id"/>
                            <field name="user_id"/>
                            <field name="date"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
