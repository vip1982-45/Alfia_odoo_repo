<odoo>
    <!-- Password policy and session time-out. noupdate: administrators may tune these afterwards. -->
    <data noupdate="1">
        <record id="auth_password_policy.minlength" model="ir.config_parameter">
            <field name="value">12</field>
        </record>
        <record id="base.group_user" model="res.groups">
            <field name="lock_timeout_inactivity">30</field>
            <field name="lock_timeout">720</field>
        </record>
    </data>

    <!-- Starter profiles: functions only. Sites, warehouses and journals are added per farm. -->
    <data noupdate="1">
        <record id="profile_stable_staff" model="alfia.access.profile">
            <field name="name">Stable staff (grooms, foremen)</field>
            <field name="description">Records daily care and receives stock for their own barn. Add the barn's stock location.</field>
            <field name="group_ids" eval="[(6, 0, [ref('group_alfia_stable_user'), ref('stock.group_stock_user')])]"/>
        </record>
        <record id="profile_breeding_staff" model="alfia.access.profile">
            <field name="name">Breeding staff</field>
            <field name="group_ids" eval="[(6, 0, [ref('group_alfia_breeding_user'), ref('stock.group_stock_user')])]"/>
        </record>
        <record id="profile_breeding_manager" model="alfia.access.profile">
            <field name="name">Breeding manager</field>
            <field name="group_ids" eval="[(6, 0, [ref('group_alfia_breeding_manager'), ref('stock.group_stock_user')])]"/>
        </record>
        <record id="profile_training_staff" model="alfia.access.profile">
            <field name="name">Training staff</field>
            <field name="group_ids" eval="[(6, 0, [ref('group_alfia_training_user'), ref('stock.group_stock_user')])]"/>
        </record>
        <record id="profile_training_manager" model="alfia.access.profile">
            <field name="name">Training manager</field>
            <field name="group_ids" eval="[(6, 0, [ref('group_alfia_training_manager'), ref('stock.group_stock_user')])]"/>
        </record>
        <record id="profile_vet_staff" model="alfia.access.profile">
            <field name="name">Veterinary staff</field>
            <field name="group_ids" eval="[(6, 0, [ref('group_alfia_vet_user'), ref('group_alfia_medicine_custodian')])]"/>
        </record>
        <record id="profile_resident_vet" model="alfia.access.profile">
            <field name="name">Resident veterinarian</field>
            <field name="group_ids" eval="[(6, 0, [ref('group_alfia_vet_manager'), ref('group_alfia_medicine_custodian'), ref('group_alfia_dispatch_vet_approver')])]"/>
        </record>
        <record id="profile_semen_custodian" model="alfia.access.profile">
            <field name="name">Semen and embryo custodian</field>
            <field name="description">Moves semen and embryos in the tank store. Add the tank locations.</field>
            <field name="group_ids" eval="[(6, 0, [ref('group_alfia_semen_custodian')])]"/>
        </record>
        <record id="profile_dispatch_admin_approver" model="alfia.access.profile">
            <field name="name">Dispatch approver (administration)</field>
            <field name="group_ids" eval="[(6, 0, [ref('group_alfia_dispatch_admin_approver')])]"/>
        </record>
        <record id="profile_storekeeper" model="alfia.access.profile">
            <field name="name">Storekeeper</field>
            <field name="group_ids" eval="[(6, 0, [ref('stock.group_stock_user')])]"/>
        </record>
        <record id="profile_stock_controller" model="alfia.access.profile">
            <field name="name">Stock controller</field>
            <field name="group_ids" eval="[(6, 0, [ref('stock.group_stock_manager'), ref('group_alfia_stock_adjust_approver'), ref('group_alfia_all_locations')])]"/>
        </record>
        <record id="profile_procurement_officer" model="alfia.access.profile">
            <field name="name">Procurement officer</field>
            <field name="group_ids" eval="[(6, 0, [ref('purchase.group_purchase_user')])]"/>
        </record>
        <record id="profile_procurement_approver" model="alfia.access.profile">
            <field name="name">Procurement approver</field>
            <field name="group_ids" eval="[(6, 0, [ref('purchase.group_purchase_manager')])]"/>
        </record>
        <record id="profile_ap_clerk" model="alfia.access.profile">
            <field name="name">Accounts payable clerk</field>
            <field name="description">Enters vendor bills. Add the purchase journals they may use.</field>
            <field name="group_ids" eval="[(6, 0, [ref('account.group_account_invoice')])]"/>
        </record>
        <record id="profile_ar_clerk" model="alfia.access.profile">
            <field name="name">Sales and receivables clerk</field>
            <field name="group_ids" eval="[(6, 0, [ref('sales_team.group_sale_salesman'), ref('account.group_account_invoice')])]"/>
        </record>
        <record id="profile_accountant" model="alfia.access.profile">
            <field name="name">Accountant</field>
            <field name="group_ids" eval="[(6, 0, [ref('account.group_account_user')])]"/>
        </record>
        <record id="profile_finance_controller" model="alfia.access.profile">
            <field name="name">Finance controller</field>
            <field name="group_ids" eval="[(6, 0, [ref('account.group_account_manager'), ref('group_alfia_all_journals'), ref('group_alfia_all_warehouses')])]"/>
        </record>
        <record id="profile_auditor" model="alfia.access.profile">
            <field name="name">Auditor (read-only)</field>
            <field name="group_ids" eval="[(6, 0, [ref('group_alfia_security_auditor')])]"/>
        </record>
    </data>
</odoo>
