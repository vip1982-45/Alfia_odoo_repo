<odoo>
    <record id="alfia_charge_view_pivot" model="ir.ui.view">
        <field name="name">alfia.charge.pivot</field>
        <field name="model">alfia.charge</field>
        <field name="arch" type="xml"><pivot><field name="product_id" type="row"/><field name="state" type="col"/><field name="amount" type="measure"/></pivot></field>
    </record>
    <record id="alfia_charge_view_graph" model="ir.ui.view">
        <field name="name">alfia.charge.graph</field>
        <field name="model">alfia.charge</field>
        <field name="arch" type="xml"><graph type="bar"><field name="product_id"/><field name="amount" type="measure"/></graph></field>
    </record>
    <record id="alfia_diet_line_view_pivot" model="ir.ui.view">
        <field name="name">alfia.diet.line.pivot</field>
        <field name="model">alfia.diet.line</field>
        <field name="arch" type="xml"><pivot><field name="product_id" type="row"/><field name="daily_qty" type="measure"/></pivot></field>
    </record>
    <record id="alfia_report_breeding_view_pivot" model="ir.ui.view">
        <field name="name">alfia.report.breeding.pivot</field>
        <field name="model">alfia.report.breeding</field>
        <field name="arch" type="xml"><pivot><field name="stallion_id" type="row"/><field name="season" type="col"/><field name="services" type="measure"/><field name="pregnancies" type="measure"/><field name="live_foals" type="measure"/></pivot></field>
    </record>
    <record id="alfia_report_breeding_view_graph" model="ir.ui.view">
        <field name="name">alfia.report.breeding.graph</field>
        <field name="model">alfia.report.breeding</field>
        <field name="arch" type="xml"><graph type="bar"><field name="stallion_id"/><field name="pregnancies" type="measure"/></graph></field>
    </record>
    <record id="alfia_event_view_calendar" model="ir.ui.view">
        <field name="name">alfia.event.calendar</field>
        <field name="model">alfia.event</field>
        <field name="arch" type="xml"><calendar date_start="date_start" date_stop="date_end" string="Events"><field name="name"/></calendar></field>
    </record>
    <record id="alfia_task_view_calendar" model="ir.ui.view">
        <field name="name">alfia.task.calendar</field>
        <field name="model">alfia.task</field>
        <field name="arch" type="xml"><calendar date_start="due_date" string="Work items" color="kind"><field name="name"/><field name="horse_id"/></calendar></field>
    </record>
    <record id="alfia_equine.alfia_task_action" model="ir.actions.act_window">
        <field name="view_mode">list,form,calendar</field>
    </record>
    <record id="alfia_horse_import_view_form" model="ir.ui.view">
        <field name="name">alfia.horse.import.form</field>
        <field name="model">alfia.horse.import</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="file" filename="filename"/><field name="filename" invisible="1"/>
                    <field name="skip_existing"/>
                    <div class="text-muted">Columns: name, sex (female/male/gelding), birthdate (YYYY-MM-DD), breed.</div>
                </group>
                <field name="result" invisible="not result"/>
                <footer><button name="action_import" type="object" string="Import" class="btn-primary"/><button string="Close" special="cancel"/></footer>
            </form>
        </field>
    </record>
    <record id="alfia_horse_import_action" model="ir.actions.act_window">
        <field name="name">Import horses</field>
        <field name="res_model">alfia.horse.import</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
