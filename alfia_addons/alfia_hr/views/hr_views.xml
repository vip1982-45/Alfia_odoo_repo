<odoo>
    <record id="alfia_hr_employee_form" model="ir.ui.view">
        <field name="name">hr.employee.form.alfia</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='visa_expire']" position="after">
                <field name="alfia_qid_expiry"/>
                <field name="alfia_passport_expiry"/>
                <field name="alfia_health_card_expiry"/>
                <field name="alfia_access_revoked" invisible="not alfia_access_revoked"/>
            </xpath>
        </field>
    </record>
    <record id="alfia_hr_profile_form" model="ir.ui.view">
        <field name="name">alfia.access.profile.form.hr</field>
        <field name="model">alfia.access.profile</field>
        <field name="inherit_id" ref="alfia_security.alfia_access_profile_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='journal_ids']" position="after">
                <field name="department_ids" widget="many2many_tags"/>
            </xpath>
        </field>
    </record>
    <record id="alfia_hr_site_setup_form" model="ir.ui.view">
        <field name="name">alfia.site.setup.form.hr</field>
        <field name="model">alfia.site.setup</field>
        <field name="inherit_id" ref="alfia_security.alfia_site_setup_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='template_ids']" position="after">
                <field name="department_parent_id"/>
            </xpath>
        </field>
    </record>
</odoo>
