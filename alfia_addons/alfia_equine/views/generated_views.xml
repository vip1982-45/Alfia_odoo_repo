<odoo>

    <record id="alfia_task_view_list" model="ir.ui.view">
        <field name="name">alfia.task.list</field>
        <field name="model">alfia.task</field>
        <field name="arch" type="xml"><list><field name="due_date"/><field name="horse_id"/><field name="name"/><field name="kind"/><field name="urgent"/><field name="assigned_group_id"/><field name="state"/></list></field>
    </record>
    <record id="alfia_task_view_form" model="ir.ui.view">
        <field name="name">alfia.task.form</field>
        <field name="model">alfia.task</field>
        <field name="arch" type="xml">
            <form><header><button name="action_done" string="Mark done" type="object" class="btn-primary" invisible="state in ('done','cancelled')"/><button name="action_defer" string="Defer" type="object" class="" invisible="state != 'todo'"/><button name="action_cancel" string="Cancel" type="object" class="" invisible="state in ('done','cancelled')"/><field name="state" widget="statusbar"/></header><sheet><group><group><field name="name"/><field name="horse_id"/><field name="kind"/><field name="due_date"/></group><group><field name="urgent"/><field name="assigned_user_id"/><field name="assigned_group_id"/><field name="state"/></group></group><group><field name="notes"/></group></sheet><chatter/></form>
        </field>
    </record>
    <record id="alfia_task_view_search" model="ir.ui.view">
        <field name="name">alfia.task.search</field>
        <field name="model">alfia.task</field>
        <field name="arch" type="xml"><search><field name="name"/><field name="horse_id"/><filter name="todo" string="To do" domain="[('state', '=', 'todo')]"/><filter name="overdue" string="Overdue" domain="[('overdue', '=', True)]"/><filter name="urgent" string="Urgent" domain="[('urgent', '=', True)]"/></search></field>
    </record>
    <record id="alfia_task_action" model="ir.actions.act_window">
        <field name="name">Work items</field>
        <field name="res_model">alfia.task</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_todo': 1}</field>
    </record>

