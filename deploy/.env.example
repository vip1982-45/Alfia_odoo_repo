# Copy to .env and replace every value. Generate passwords with:  openssl rand -base64 24
# The public address users will open, e.g. stud-demo.example.com (its DNS must point at this server).
SITE_ADDRESS=stud-demo.example.com
# Database password (internal only).
DB_PASSWORD=change-me-database
# Odoo master password (protects database management; it is also switched off from the web).
MASTER_PASSWORD=change-me-master
# Password shared by the evaluation accounts (groom.a, vet, accountant...). At least 12 characters.
DEMO_PASSWORD=change-me-evaluators
# Password of the 'admin' account. Keep it to the project team. At least 12 characters.
ADMIN_PASSWORD=change-me-admin
# 1 = load the invented demonstration farm on first start; 0 = start with an empty system.
LOAD_DEMO_FARM=1
