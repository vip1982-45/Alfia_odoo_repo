# Settings for the Azure trial, used by the GitHub workflow .github/workflows/azure-trial.yml.
# Nothing here is secret. Write values without quotes; separate several addresses with a space.
# Changing this file on branch claude/alfia-hardening starts the workflow (Actions > Azure trial).
AZURE_CLIENT_ID=
AZURE_TENANT_ID=
AZURE_SUBSCRIPTION_ID=
WEB_CIDRS=
ADMIN_CIDRS=
OWNER=it-operations
COSTCENTER=stud-farm
DNS_LABEL=alfia-stud-trial
